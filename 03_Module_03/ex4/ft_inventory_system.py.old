import sys


def sort_list(liste: list) -> list:
    """Sort List in Descending order"""
    tempo: list = []
    x: int = 0
    y: int = 0
    total_elem: int = len(liste)
    before_last = total_elem - 1
    for x in range(before_last):
        for y in range((x + 1), total_elem):
            liste[x][1] = int(liste[x][1])
            liste[y][1] = int(liste[y][1])
            if liste[x][1] < liste[y][1]:
                tempo = liste[x]
                liste[x] = liste[y]
                liste[y] = tempo
    return liste


def recup_dict(list_args: list) -> dict:
    """List to Dictionary"""
    list_split: list = []
    moderate = dict()
    scarce = dict()

    for args in list_args:
        list_split.append(args.split(":"))
    list_split = sort_list(list_split)
    for one_split in list_split:
        if one_split[1] >= 4:
            moderate[one_split[0]] = one_split[1]
        else:
            scarce[one_split[0]] = one_split[1]
    args_dict = dict()
    args_dict = {"moderate": moderate, "scarce": scarce}
    return args_dict


def items_counter(dictionary: dict) -> tuple[int, int]:
    """Count qty total Items and qty Items name"""
    value_list = list(dictionary.values())
    qty_items_type: int = 0
    total_value: int = 0
    for nbr in value_list:
        total_value += int(nbr)
        qty_items_type += 1
    return qty_items_type, total_value


def print_inventory(dicitonary: dict, total_value: int) -> None:
    """Dispay Inventory on Screen"""
    keys_list = list(dicitonary.keys())
    for key in keys_list:
        percent_value: float = 100 * int(dicitonary[key]) / total_value
        print(f"{key}: {dicitonary[key]} units ({percent_value:.1f}%)")


def main() -> None:
    """Inventory System"""
    item_list: list = []
    invent_dict = recup_dict(sys.argv[1:])
    qty_items_type1, total_value1 = items_counter(invent_dict["moderate"])
    qty_items_type2, total_value2 = items_counter(invent_dict["scarce"])
    qty_items_type = qty_items_type1 + qty_items_type2
    total_value = total_value1 + total_value2
    print("=== Inventory System Analysis ===")
    print(f"Total items in inventory: {total_value}")
    print(f"Unique item types: {qty_items_type}")
    print()
    print("=== Current Inventory ===")
    print_inventory(invent_dict["moderate"], total_value)
    print_inventory(invent_dict["scarce"], total_value)
    print()
    item_list = invent_dict["moderate"].items()
    item_list.append(invent_dict["scarce"].items())
    print("=== Inventory Statistics ===")
    print(f"Most abundant: {item_list[0][0]} ({item_list[0][1]} units)")
    print("Least abundant:        sword (1 unit)")


if __name__ == "__main__":
    main()


